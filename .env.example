# Razorpay TEST mode only. Never put a real key in this file - it is committed.
#
# A live credential pair was committed here on 29 Aug 2026 and stayed in the
# repository until 5 Sept. That key is rotated and dead. The test below
# (tests/test_no_credentials.py) now fails if this file ever again contains
# anything that looks like a real key, because "remember not to" is not a
# control.
#
# Copy to .env (which IS gitignored) and fill in there, never here.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx
CHUKTA_DRY_RUN=1
